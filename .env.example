# ShelfReady configuration — NO API KEY NEEDED.
# The pipeline talks to Claude through the `claude` CLI (your existing login).

# Path/name of the Claude CLI binary (default: claude on PATH)
SHELFREADY_CLAUDE_BIN=claude

# Per-call timeout for the CLI, in seconds
SHELFREADY_CLAUDE_TIMEOUT=120

# Engine selection is per-request (engine="offline" | "claude").
# The offline deterministic engine is the default and needs nothing installed.
